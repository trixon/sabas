<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE filesystem PUBLIC "-//NetBeans//DTD Filesystem 1.2//EN" "http://www.netbeans.org/dtds/filesystem-1_2.dtd">
<filesystem>
    <folder name="Actions">
        <folder name="Edit">
            <file name="org-openide-actions-DeleteAction.instance_hidden"/>
        </folder>
        <folder name="Help">
            <file name="org-netbeans-core-actions-AboutAction.instance">
                <attr name="delegate" newvalue="se.trixon.sabas.actions.AboutAction"/>
                <attr name="instanceCreate" methodvalue="org.openide.awt.Actions.alwaysEnabled"/>
                <attr name="displayName" bundlevalue="org.netbeans.core.actions.Bundle#About"/>
                <attr name="noIconInMenu" boolvalue="true"/>
            </file>
        </folder>
    </folder>

    <folder name="Menu">
        <file name="Edit_hidden"/>
        <folder name="File">
            <file name="Separator2.instance_hidden"/>
            <file name="Separator3.instance_hidden"/>
            <file name="Separator4.instance_hidden"/>
            <file name="org-openide-actions-PageSetupAction.shadow_hidden"/>
            <file name="org-openide-actions-PrintAction.shadow_hidden"/>
            <file name="org-openide-actions-SaveAction.shadow_hidden"/>
            <file name="org-openide-actions-SaveAllAction.shadow_hidden"/>
            <file name="org-openide-actions-SaveAsAction.shadow_hidden"/>
        </folder>
        <file name="GoTo_hidden"/>
        <folder name="Help">
            <file name="Separator1.instance_hidden"/>
            <file name="org-netbeans-modules-autoupdate-ui-actions-CheckForUpdatesAction.shadow_hidden"/>
        </folder>
        <folder name="View_hidden"/>
        <folder name="Tools">
            <file name="Separator1.instance_hidden"/>
            <file name="Separator2.instance_hidden"/>
            <file name="org-netbeans-core-actions-LogAction.shadow_hidden"/>
        </folder>
        <folder name="View">
            <file name="Separator2.instance_hidden"/>
            <file name="Separator3.instance_hidden"/>
            <file name="ShowEditorOnlyAction.shadow_hidden"/>
            <file name="ToggleFullScreenAction.shadow_hidden"/>
            <file name="org-netbeans-core-windows-actions-ToolbarsListAction.shadow_hidden"/>
        </folder>
        <!--<file name="Window_hidden"/>-->
        <file name="se-trixon-sabas-ui-parts-QuickSearchAction.shadow">
            <attr name="originalFile" stringvalue="Actions/Edit/org-netbeans-modules-quicksearch-QuickSearchAction.instance"/>
            <attr name="position" intvalue="10000"/>
        </file>
    </folder>

    <folder name="OptionsDialog">
        <folder name="Advanced">
            <file name="org-netbeans-core-ui-options-filetypes-FileAssociationsOptionsPanelController.instance_hidden"/>
        </folder>
        <folder name="Appearance">
            <file name="DocumentTabs.instance_hidden"/>
            <file name="Windows.instance_hidden"/>
        </folder>
        <file name="General.instance_hidden"/>
        <file name="Keymaps.instance_hidden"/>
    </folder>

    <folder name="QuickSearch">
        <folder name="Packages">
            <attr name="command" stringvalue="p"/>
            <attr name="position" intvalue="0"/>
            <file name="se-trixon-sabas-core-PkgTextSearchProvider.instance">
                <attr name="displayName" bundlevalue="se.trixon.sabas.Bundle#QuickSearchPkgTextSearchProvider"/>
            </file>
        </folder>
    </folder>
    <folder name="Shortcuts">
        <file name="DS-ENTER.shadow_hidden"/>
        <file name="OS-ENTER.shadow_hidden"/>
        <!--<file name="D-4.shadow_hidden"/>-->
        <!--        <file name="D-4.shadow">
            <attr name="originalFile" stringvalue="Actions/Window/se-trixon-sabas-ui-FilterVendorTopComponent.instance"/>
        </file>-->
        <file name="D-COMMA.shadow">
            <attr name="originalFile" stringvalue="Actions/Window/org-netbeans-modules-options-OptionsWindowAction.instance"/>
        </file>
        <file name="CS-Q.shadow">
            <attr name="originalFile" stringvalue="Actions/File/se-trixon-almond-nbp-actions-RestartAction.instance"/>
        </file>
        <file name="DS-X.shadow">
            <attr name="originalFile" stringvalue="Actions/System/org-netbeans-modules-autoupdate-ui-actions-PluginManagerAction.instance"/>
        </file>
    </folder>
    <file name="Toolbars_hidden"/>
    <folder name="Windows2">
        <folder name="Modes">
            <file name="center.wsmode" url="centerWsmode.xml"/>
            <file name="left.wsmode" url="left1Wsmode.xml"/>
            <file name="left2.wsmode" url="left2Wsmode.xml"/>
            <file name="left3.wsmode" url="left3Wsmode.xml"/>
            <file name="left4.wsmode" url="left4Wsmode.xml"/>
            <file name="left5.wsmode" url="left5Wsmode.xml"/>
            <file name="list.wsmode" url="listWsmode.xml"/>
            <file name="right.wsmode" url="rightWsmode.xml"/>
        </folder>
    </folder>
</filesystem>
